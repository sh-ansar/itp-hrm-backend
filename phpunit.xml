<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Test isolation: never inherit write flags from the developer's local .env. -->
        <env name="HRM_PERSONNEL_WRITES_ENABLED" value="false" force="true"/>
        <env name="HRM_DOCUMENT_WRITES_ENABLED" value="false" force="true"/>
        <env name="HRM_WORKTIME_WRITES_ENABLED" value="false" force="true"/>
        <env name="HRM_WORKTIME_EMPLOYMENT_GUARD_ENABLED" value="false" force="true"/>
        <env name="HRM_WORKTIME_PERIOD_APPROVALS_ENABLED" value="false" force="true"/>
        <env name="HRM_LEAVE_WRITES_ENABLED" value="false" force="true"/>
        <env name="HRM_PROTECTED_LEAVE_EVIDENCE_ENABLED" value="false" force="true"/>
        <env name="HRM_PROTECTED_LEAVE_EVIDENCE_REQUIRED" value="false" force="true"/>
        <env name="HRM_MEDICAL_LEAVE_EVIDENCE_REQUIRED" value="false" force="true"/>
        <env name="HRM_LEAVE_MANAGER_APPROVAL_ENABLED" value="false" force="true"/>
        <env name="HRM_BONUS_WRITES_ENABLED" value="false" force="true"/>
        <env name="HRM_ROLE_MANAGEMENT_ENABLED" value="false" force="true"/>
        <env name="HRM_BROWSER_LOGIN_ENABLED" value="false" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
