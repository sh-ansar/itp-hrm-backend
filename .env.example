APP_NAME="ITP HRM"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=itp_hrm
DB_USERNAME=itp_hrm
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

APP_KEY=

# Keep false until approved company access policy and secure session/CSRF setup.
HRM_ROLE_MANAGEMENT_ENABLED=false

# Worktime mutations remain OFF until import/edit workflows and approval rules are released.
HRM_WORKTIME_WRITES_ENABLED=false

# Leave mutations stay OFF until approval/import/edit workflows are released.
HRM_LEAVE_WRITES_ENABLED=false

# Browser login stays OFF until first-party origin + HTTPS and CSRF review.
HRM_BROWSER_LOGIN_ENABLED=false

# Development HTTP may set false; REQUIRED true behind correctly trusted HTTPS proxies in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
