APP_NAME="ITP HRM"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=itp_hrm
# Default preserves current installations; isolated HRM schema: hrm.
DB_SCHEMA=public
DB_USERNAME=itp_hrm
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

APP_KEY=

# Keep false until approved company access policy and secure session/CSRF setup.
HRM_ROLE_MANAGEMENT_ENABLED=false

# Worktime mutations remain OFF until import/edit workflows and approval rules are released.
HRM_WORKTIME_WRITES_ENABLED=false

# Leave mutations stay OFF until approval/import/edit workflows are released.
HRM_LEAVE_WRITES_ENABLED=false
HRM_LEAVE_MANAGER_APPROVAL_ENABLED=false

# Browser login stays OFF until first-party origin + HTTPS and CSRF review.
HRM_BROWSER_LOGIN_ENABLED=false

# Development HTTP may set false; REQUIRED true behind correctly trusted HTTPS proxies in production.
SESSION_SECURE_COOKIE=false
# Only for shared-host HRM under platform.itpmining.kz/hrm/:
# SESSION_COOKIE=hrm_session
# SESSION_PATH=/
# HRM_XSRF_COOKIE_NAME=HRM-XSRF-TOKEN
# SESSION_SECURE_COOKIE=true
# Never use the default platform XSRF cookie for this deployment.
HRM_XSRF_COOKIE_NAME=XSRF-TOKEN
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Monetary bonus proposals require explicit admin approval; default off.
HRM_BONUS_WRITES_ENABLED=false

# Company-scoped reference directory writes remain fail-closed until released.
HRM_DIRECTORY_WRITES_ENABLED=false

# Private personnel files (never use MINIO_ROOT_USER / MINIO_ROOT_PASSWORD for this API).
# Provision a private bucket and scoped service credentials separately.
MINIO_ENDPOINT=https://minio.internal.example
MINIO_BUCKET=hrm-private
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
HRM_LEGACY_DOCUMENT_READS_ENABLED=false

# Manual, audited and non-destructive legacy PDF migration; never enable automatically.
HRM_DOCUMENT_STORAGE_MIGRATION_ENABLED=false
